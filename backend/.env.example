# StackBot Backend — Environment Variables
# Copy to .env and fill in your values

# Qdrant Cloud (https://cloud.qdrant.io → create free cluster)
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=stackbot_docs

# Groq (https://console.groq.com → API Keys)
GROQ_API_KEY=gsk_your_groq_api_key

# CORS — set to your deployed Vercel frontend URL in production
FRONTEND_ORIGIN=http://localhost:5173
